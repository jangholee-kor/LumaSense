# ESP32-S3FH4R2 shown in the user's board photo: 4 MB flash, PSRAM disabled.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SMC_PRESENCE_VL53L1X=y
CONFIG_SMC_WIFI_TX_POWER_LIMIT=y
CONFIG_SMC_WIFI_MAX_TX_POWER_QDBM=60
CONFIG_SMC_I2C_SDA=12
CONFIG_SMC_I2C_SCL=13
CONFIG_SMC_TOF_SHUT_GPIO=4
CONFIG_SMC_TOF_ROI_SIZE=8
CONFIG_SMC_STATUS_LED_GPIO=48
# CONFIG_SPIRAM is not set
