menu "Smart Monitor Controller"
    config SMC_I2C_SDA
        int "BH1750 SDA GPIO (example wiring)"
        default 8
        range 0 48
    config SMC_I2C_SCL
        int "BH1750 SCL GPIO (example wiring)"
        default 9
        range 0 48
    config SMC_BH1750_ADDR
        hex "BH1750 7-bit I2C address"
        default 0x23
        range 0x23 0x5c
    config SMC_RADAR_RX
        int "ESP32 RX GPIO connected to LD2412 TX (example wiring)"
        default 16
        range 0 48
    config SMC_RADAR_TX
        int "ESP32 TX GPIO connected to LD2412 RX (example wiring)"
        default 17
        range 0 48
    config SMC_RADAR_BAUD
        int "LD2412 UART baud rate"
        default 115200
        range 9600 460800
    config SMC_REPORT_MS
        int "Telemetry interval (ms)"
        default 200
        range 100 5000
    config SMC_RADAR_STALE_MS
        int "Radar data stale timeout (ms)"
        default 2000
        range 500 10000
endmenu
